# Server Port
PORT=5055

NODE_ENV=development

# MongoDB Connection URI
# Local: mongodb://127.0.0.1:27017/disaster-management
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/disaster-management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/disaster-management

# JWT (JSON Web Token) Security Secret & Expiration
JWT_SECRET=disaster_management_jwt_super_secret_key_2026_production_grade
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS & Cookie Origin
FRONTEND_URL=http://localhost:5173

# FastAPI AI Microservice URL
FASTAPI_URL=http://localhost:8000

# AI APIs
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Weather API
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Government of India Bhashini Translation API (ULCA Pipeline)
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ── Early Warning Alert System (SIH26002) ────────────────────────────────────
# Twilio SMS Credentials
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Nodemailer SMTP Email Credentials (e.g. Gmail App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=admin.disaster@sih26002.gov.in
EMAIL_PASS=your_email_app_password_here

# Mock/Testing Admin Alert Recipients
ADMIN_PHONE=+919876543210
ADMIN_EMAIL=district.admin@sih26002.gov.in

